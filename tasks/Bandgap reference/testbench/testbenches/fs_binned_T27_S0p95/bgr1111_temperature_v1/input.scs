simulator lang=spectre
global 0
include "<PDK_ROOT>/sky130_cds/spectre/libs.tech/spectre/sky130.lib.spice" section=fs
include "dut.scs"

parameters vsup=1.71 vneg=0.0
// Supplies (charged to the DUT power metrics).
VSUP (vdd 0) vsource dc=vsup
VNEG (vss 0) vsource dc=vneg

nodeset out=1.2 XDUT.BIAS=0.66 XDUT.VINP=0.55 XDUT.VINN=0.55

XDUT (vss vdd out) bgr_fig3_paper CC=1e-12 L_M4=1e-06 L_M8=1e-06 L_M9=1e-06 L_NLD=1e-06 L_PBIAS=1e-06 L_PIN=1e-06 L_PMIR=1e-06 L_PTAT=1e-06 M_M10=1.0 M_M11=1.0 M_M12=1.0 M_M13=1.0 M_M4=1.0 M_M8=1.0 M_M9=1.0 M_PBIAS=1.0 M_PMIR=1.0 M_PTAT=1.0 NF_M10=1.0 NF_M11=1.0 NF_M12=1.0 NF_M13=1.0 NF_M4=1.0 NF_M8=1.0 NF_M9=1.0 NF_PBIAS=1.0 NF_PMIR=1.0 NF_PTAT=1.0 R1=10000.0 R2=10000.0 R3=10000.0 R4=10000.0 W_M10=1e-06 W_M11=1e-06 W_M12=1e-06 W_M13=1e-06 W_M4=1e-06 W_M8=1e-06 W_M9=1e-06 W_PBIAS=1e-06 W_PMIR=1e-06 W_PTAT=1e-06

opts options temp=27.0 tnom=27 reltol=0.0001 save=selected
save VNEG:p VSUP:p out vdd vss

bgropts options reltol=1e-05 vabstol=1e-09 iabstol=1e-13 gmin=1e-12 pivrel=0.001 rforce=1 soft_bin=allmodels
tsw dc param=temp start=-40.0 stop=120.0 step=1.0
