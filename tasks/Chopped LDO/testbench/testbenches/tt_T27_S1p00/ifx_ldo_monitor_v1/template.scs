// analogiq 0.1.0 testbench - generated, do not edit
// task ldo_ifx_task_001  topology ldo_ifx
// recipe ifx_ldo_monitor_v1 v1  condition tt_T27_S1p00 (models tt, 27 C, supply 3.3 V)
// request ldo_ifx_task_001__plan  candidate b9319a3b22d0f867
// execution profile search_full
simulator lang=spectre
global 0
include "<PDK_ROOT>/sky130_cds/spectre/libs.tech/combined/sky130.lib.spice" section=tt
include "dut.scs"

parameters vin=3.3 vlo=2.4 vcu=0.0 vcd=0.0
// Supplies (charged to the DUT power metrics).
VIN (vin 0) vsource dc=vlo+vcu-vcd
// External bias (topology external_bias; reported separately as bias power).
VB_inh_lSup (b_inh_lSup 0) vsource dc=0.0
VB_inh_bulkn (b_inh_bulkn 0) vsource dc=0.0
VB_inh_bulkpanalog (vin b_inh_bulkpanalog) vsource dc=0.0
VB_clk_i (b_clk_i 0) vsource dc=0.0
VB_disable_i (b_disable_i 0) vsource dc=0.0
IB_ibp_1u_ai (vin b_ibp_1u_ai) isource dc=1e-06

VREFS (vref 0) vsource dc=1.2
RLOAD (out 0) resistor r=75.0
CFOV (open_overvoltage_o 0) capacitor c=50f
CFUV (open_undervoltage_o 0) capacitor c=50f

XDUT (b_clk_i b_disable_i b_ibp_1u_ai open_overvoltage_o open_undervoltage_o out vref b_inh_bulkn b_inh_bulkpanalog vin b_inh_lSup) ldo_ifx_dut C_INT={{C_INT}} C_MILLER={{C_MILLER}} C_SCF={{C_SCF}} L_CMP_DN={{L_CMP_DN}} L_CMP_DP={{L_CMP_DP}} L_CMP_IN={{L_CMP_IN}} L_CMP_LN={{L_CMP_LN}} L_CMP_MP={{L_CMP_MP}} L_CMP_ON={{L_CMP_ON}} L_CMP_OP={{L_CMP_OP}} L_FOL={{L_FOL}} L_OA_CS={{L_OA_CS}} L_OA_IB={{L_OA_IB}} L_OA_IN={{L_OA_IN}} L_OA_LD={{L_OA_LD}} L_OA_PRN={{L_OA_PRN}} L_OA_PRP={{L_OA_PRP}} L_OA_SCAS={{L_OA_SCAS}} L_OA_SNK={{L_OA_SNK}} L_OA_TCAS={{L_OA_TCAS}} L_OA_TSRC={{L_OA_TSRC}} L_OA_VB={{L_OA_VB}} L_PASS={{L_PASS}} L_RES={{L_RES}} M_CMP_DN={{M_CMP_DN}} M_CMP_DP={{M_CMP_DP}} M_CMP_LN={{M_CMP_LN}} M_CMP_ON={{M_CMP_ON}} M_CMP_OP={{M_CMP_OP}} M_OA_IB={{M_OA_IB}} M_OA_LD={{M_OA_LD}} M_OA_PRN={{M_OA_PRN}} M_OA_PRP={{M_OA_PRP}} M_OA_TCAS={{M_OA_TCAS}} M_OA_TSRC={{M_OA_TSRC}} M_OA_VB={{M_OA_VB}} M_RES={{M_RES}} N_FOL={{N_FOL}} N_OA_CS={{N_OA_CS}} N_OA_SNK={{N_OA_SNK}} N_PASS={{N_PASS}} R_CMP_TAIL={{R_CMP_TAIL}} R_FB_BOT={{R_FB_BOT}} R_FB_TOP={{R_FB_TOP}} R_UV_BOT={{R_UV_BOT}} R_UV_MID={{R_UV_MID}} R_UV_TOP={{R_UV_TOP}} W_CMP_DN={{W_CMP_DN}} W_CMP_DP={{W_CMP_DP}} W_CMP_IN={{W_CMP_IN}} W_CMP_LN={{W_CMP_LN}} W_CMP_MP={{W_CMP_MP}} W_CMP_ON={{W_CMP_ON}} W_CMP_OP={{W_CMP_OP}} W_FOL={{W_FOL}} W_OA_CS={{W_OA_CS}} W_OA_IB={{W_OA_IB}} W_OA_IN={{W_OA_IN}} W_OA_LD={{W_OA_LD}} W_OA_PRN={{W_OA_PRN}} W_OA_PRP={{W_OA_PRP}} W_OA_SCAS={{W_OA_SCAS}} W_OA_SNK={{W_OA_SNK}} W_OA_TCAS={{W_OA_TCAS}} W_OA_TSRC={{W_OA_TSRC}} W_OA_VB={{W_OA_VB}} W_PASS={{W_PASS}} W_RES={{W_RES}}

opts options temp=27.0 tnom=27 reltol=0.0001 save=selected
save VB_clk_i:p VB_disable_i:p VB_inh_bulkn:p VB_inh_bulkpanalog:p VB_inh_lSup:p VIN:p XDUT.N00038 XDUT.N00049 XDUT.N00055 XDUT.N00063 XDUT.N00064 XDUT.N00067 XDUT.N00069 open_overvoltage_o open_undervoltage_o out vin vref

dcu dc param=vcu start=0 stop=2.0000000000000004 step=0.025
top alter param=vcu value=2.0000000000000004
dcd dc param=vcd start=0 stop=2.0000000000000004 step=0.025
