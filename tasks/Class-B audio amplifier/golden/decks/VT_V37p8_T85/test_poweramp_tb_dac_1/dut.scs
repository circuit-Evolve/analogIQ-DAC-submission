    R30 (driver_n_base VN) resistor r=1330
    R29 (driver_n_buffer_e VN) resistor r=1000
    R28 (drive_negative VN) resistor r=1330
    R25 (VP driver_p_e) resistor r=6
    R24 (VP driver_p_base) resistor r=1330
    R23 (VP driver_p_buffer_e) resistor r=1000
    R22 (VP drive_positive) resistor r=1330
    R21 (tail2n_e VN7) resistor r=36
    R20 (GND bias2n) resistor r=10000
