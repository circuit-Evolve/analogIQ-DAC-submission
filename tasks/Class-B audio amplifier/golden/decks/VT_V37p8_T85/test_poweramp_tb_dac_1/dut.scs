simulator lang=spectre
subckt poweramp ERROR GND IN LOAD OUT REF6 V15 VN VN7 VP inh_bulk_n
parameters input_filter_scale=1
    L1 (OUT LOAD) inductor l=2e-6
    D2 (drive_negative driver_n_base) nscw100
    D1 (driver_p_base drive_positive) nscw100
    D4 (stage1 REF6) dan202um
    D3 (REF6 stage1) dan202um
    Q18 (VP output_p_base output_p_e inh_bulk_n) njw0281g
    Q20 (output_p_base output_bias output_n_base inh_bulk_n) bd139
    Q22 (output_n_base driver_n_base driver_n_e inh_bulk_n) \
        ksc2690a_gp_approx
    Q21 (drive_negative driver_n_base driver_n_buffer_e inh_bulk_n) \
        mmbt6429_kn_approx
    Q15 (bias2n tail2n_e VN7 inh_bulk_n) mmbt6429_kn_approx
