// analogiq 0.1.0 testbench - generated, do not edit
// task nclna02_task_001  topology nclna02_das_2021
// recipe lna_diff_ip3_v1 v1  condition NN_T27_S1p00 (models NN, 27 C, supply 1.5 V)
// request nclna02_task_001__plan  candidate bafe0aef0eea6b56
// execution profile search_full
simulator lang=spectre
global 0
include "<CADENCE_SHARED>/FOUNDRY/analog/180nm/models/spectre/gpdk.scs" section=NN
include "dut.scs"

parameters vsup=1.5
// Sizing variables set in the testbench (external-bias values).
parameters V_BN={{V_BN}} V_BP={{V_BP}}
// Supplies (charged to the DUT power metrics).
VSUP (vdd 0) vsource dc=vsup
// External bias (topology external_bias; reported separately as bias power).
VB_VSS (b_VSS 0) vsource dc=0.0
VB_Vbn (b_Vbn 0) vsource dc=V_BN
VB_Vbp (b_Vbp 0) vsource dc=V_BP

// Measurement instrumentation: single-ended port of 2*Z0 into an ideal balun (two 2:1 ideal
// transformers, centre tap at ground), ideal input DC blocks, open outputs with noiseless DC returns.
P1 (bal 0) port r=100.0 num=1 type=sine freq=500000000.0 dbm=-40.0 fundname="f1" freq2=510000000.0 dbm2=-40.0 fundname2="f2"
TBP (bal 0 sbp 0) transformer n1=2 n2=1
TBN (bal 0 0 sbn) transformer n1=2 n2=1
CBIP (sbp rfin) capacitor c=1e-06
CBIN (sbn rfn) capacitor c=1e-06
RDCP (rfout 0) resistor r=1000000000.0 isnoisy=no
RDCN (rfoutn 0) resistor r=1000000000.0 isnoisy=no

XDUT (rfin rfn rfout rfoutn vdd b_VSS b_Vbn b_Vbp) nclna02_dut C_C={{C_C}} C_O={{C_O}} L_N={{L_N}} L_P={{L_P}} N_N={{N_N}} N_P={{N_P}} R_C={{R_C}} R_L={{R_L}} W_N={{W_N}} W_P={{W_P}}

opts options temp=27.0 tnom=27 reltol=0.0001 save=selected
save VB_VSS:p VB_Vbn:p VB_Vbp:p VSUP:p rfin rfn rfout rfoutn vdd

hb1 hb funds=["f1" "f2"] maxharms=[3 3] errpreset=moderate
