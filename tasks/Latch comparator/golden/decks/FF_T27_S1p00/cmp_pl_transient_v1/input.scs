// analogiq 0.1.0 testbench - generated, do not edit
// task cmppl24_task_001  topology cmppl24_upcon2022
// recipe cmp_pl_transient_v1 v2  condition FF_T27_S1p00 (models FF, 27 C, supply 1.8 V)
// request golden_cmppl24_task_001  candidate eca5dc39e87484f5
// execution profile search_full
simulator lang=spectre
global 0
include "<CADENCE_SHARED>/FOUNDRY/analog/180nm/models/spectre/gpdk.scs" section=FF
include "dut.scs"

parameters vdd_v=1.8 tclk=1e-09 tr=2e-11 cl=5e-15 vcm=0.8 vid=0.001

// Supply (the only source charged to the DUT energy metric).
VSUP (vdd 0) vsource dc=vdd_v
// Ideal clock: reset phase first; evaluating 50% edge at k*tclk + tclk/2 (paper Fig. 3: CLK high from 500 ps).
VCLK (clk 0) vsource type=pulse val0=0 val1=vdd_v delay=tclk/2-tr/2 rise=tr fall=tr width=tclk/2-tr period=tclk
// Pins driven by external_bias (VSS = 0 V) and the decision reference of the single-ended output.
VB_VSS (b_vss 0) vsource dc=0.0
VREFN (outn 0) vsource dc=vdd_v/2

// Constant differential input (paper Fig. 3: one decision, input held), vid signed per run.
VINP (inp 0) vsource dc=vcm+vid/2
VINN (inn 0) vsource dc=vcm-vid/2

XDUT (vdd b_vss clk inp inn outp) cmppl24_dut L_B1N=2.2716351064342815e-07 L_B1P=1.8354989815794568e-07 L_B2N=2.5781169956795293e-07 L_B2P=4.198804937593894e-07 L_DN=7.416303648165462e-07 L_DP=2.5073108783123647e-07 L_DT=4.075788688585899e-07 L_IN=1.8496049373914e-07 L_IVN=2.0722503971729107e-07 L_IVP=2.0232616206488231e-07 L_NX=1.8539022712531696e-07 L_PX=2.254478683829309e-07 L_RSN=3.907913856742194e-07 L_RSP=5.16002755038464e-07 L_SWPQ=2.3474460677098146e-07 L_SWXY=7.197997094533754e-07 L_TAIL=2.253198119538474e-07 W_B1N=8.377656335003047e-07 W_B1P=1.417700450693859e-06 W_B2N=6.662144129651733e-07 W_B2P=1.9875106751814183e-06 W_DN=6.744669246046587e-07 W_DP=1.0223526514627396e-06 W_DT=1.1308113270681787e-06 W_IN=2.180097695320659e-05 W_IVN=7.427637559742304e-07 W_IVP=1.3828391033431987e-06 W_NX=3.6552700112107034e-06 W_PX=6.527450087097397e-07 W_RSN=1.1157864404072802e-06 W_RSP=4.1131116941262135e-07 W_SWPQ=3.7425540215549035e-06 W_SWXY=2.6290096240184055e-06 W_TAIL=1.21247680886762e-05
CLP (outp 0) capacitor c=cl

opts options temp=27.0 tnom=27 reltol=0.0001 save=selected
save clk inp inn outp outn VSUP:p VCLK:p XDUT.X XDUT.Y XDUT.P XDUT.Q XDUT.A XDUT.B XDUT.DEC XDUT.BUF

tr1 tran stop=2e-09 maxstep=2e-12 errpreset=moderate

