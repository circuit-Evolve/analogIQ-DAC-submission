design( "DAC_20261107_MISO" "VM_LP_TRAN_tb" "schematic")
modelFile( 
    '("<PDK_ROOT>/gpdk180/models/spectre/gpdk.scs" "NN")
)
analysis('tran ?stop "6e-05"  ?errpreset "conservative"  ?maxstep "1e-08"  
		?strobeperiod "7.8125e-09"  )
analysis('dc ?saveOppoint t  )
envOption(
	'analysisOrder  list("pz" "dcmatch" "stb" "tran" "envlp" "ac" "dc" "lf" "noise" "xf" "sp" "pss" "pac" "pstb" "pnoise" "pxf" "psp" "qpss" "qpac" "qpnoise" "qpxf" "qpsp" "hb" "hbac" "hbnoise" "sens" "acmatch") 
)
option(	'iabstol  "1e-14" 
	'vabstol  "1e-09" 
	'reltol  "1e-06" 
)
saveOption( 'subcktprobelvl "5" )
saveOption( 'currents "all" )
temp( 27 ) 
