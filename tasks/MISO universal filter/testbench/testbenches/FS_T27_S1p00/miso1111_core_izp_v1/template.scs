IX_SRC (0 c_x) isource dc=0 mag=1

XCORE (0 c_n c_om c_op c_op2 c_vbias vdd vss c_x c_y1 c_y2 c_z1p c_z2p c_zp) mdvccta_fig2 A2_IBIAS=1e-05 A2_L_IN=1e-06 A2_L_NDIO=1e-06 A2_L_NMIR=1e-06 A2_L_PLD=1e-06 A2_L_PMIR=1e-06 A2_M_IN=1.0 A2_M_NDIO=1.0 A2_M_NMIR=1.0 A2_M_PLD=1.0 A2_M_PMIR=1.0 A2_W_IN=1e-06 A2_W_NDIO=1e-06 A2_W_NMIR=1e-06 A2_W_PLD=1e-06 A2_W_PMIR=1e-06 FE_L_IN=1e-06 FE_L_NOUT=1e-06 FE_L_NTAIL=1e-06 FE_L_PMIR=1e-06 FE_L_POUT=1e-06 FE_M_IN=1.0 FE_M_NOUT=1.0 FE_M_NTAIL=1.0 FE_M_PMIR=1.0 FE_M_POUT=1.0 FE_W_IN=1e-06 FE_W_NOUT=1e-06 FE_W_NTAIL=1e-06 FE_W_PMIR=1e-06 FE_W_POUT=1e-06

