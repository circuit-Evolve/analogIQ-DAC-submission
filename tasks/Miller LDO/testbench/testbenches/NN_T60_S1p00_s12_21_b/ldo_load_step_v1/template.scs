// analogiq 0.1.0 testbench - generated, do not edit
// task ldo24m_miller_task_001  topology ldo24m_miller
// recipe ldo_load_step_v1 v1  condition NN_T60_S1p00_s12_21_b (models NN, 60 C, supply 2.1 V)
// request ldo24m_miller_task_001__plan  candidate ac77f2a3c8da6cc8
// execution profile search_full
simulator lang=spectre
global 0
include "<CADENCE_SHARED>/FOUNDRY/analog/180nm/models/spectre/gpdk.scs" section=NN
include "dut.scs"

parameters vin=2.1 iload=0.07 cout=5e-11
// Sizing variables set in the testbench (external-bias values).
parameters V_BIAS={{V_BIAS}}
// Supplies (charged to the DUT power metrics).
VIN (vin 0) vsource dc=vin
// External bias (topology external_bias; reported separately as bias power).
VB_VSS (b_VSS 0) vsource dc=0.0
VB_VBIAS (b_VBIAS 0) vsource dc=V_BIAS
VB_ENABLE (b_ENABLE 0) vsource dc=2.1

VREFS (vref 0) vsource dc=1.2
// Load: ideal current sink out->ground and output capacitor (+ESR).
ILOAD (out 0) isource type=pulse val0=0.0 val1=0.07 delay=4e-05 rise=2e-06 fall=2e-06 width=3.8e-05 period=8e-05
COUT (out 0) capacitor c=cout

XDUT (vin b_VSS vref b_VBIAS b_ENABLE out) ldo24m_miller_dut C_EA={{C_EA}} C_F={{C_F}} L_CM={{L_CM}} L_EA2={{L_EA2}} L_EAIN={{L_EAIN}} L_EAL={{L_EAL}} L_EAS={{L_EAS}} L_EAT={{L_EAT}} L_MAB={{L_MAB}} L_MCR={{L_MCR}} L_MSW={{L_MSW}} L_PASS={{L_PASS}} L_RFB={{L_RFB}} L_WLB={{L_WLB}} L_WLS={{L_WLS}} M_CM={{M_CM}} M_EA2={{M_EA2}} M_EAIN={{M_EAIN}} M_EAL={{M_EAL}} M_EAS={{M_EAS}} M_EAT={{M_EAT}} M_MAB={{M_MAB}} M_MCR={{M_MCR}} M_MSW={{M_MSW}} M_RFB={{M_RFB}} M_WLB={{M_WLB}} M_WLS={{M_WLS}} N_PASS={{N_PASS}} W_CM={{W_CM}} W_EA2={{W_EA2}} W_EAIN={{W_EAIN}} W_EAL={{W_EAL}} W_EAS={{W_EAS}} W_EAT={{W_EAT}} W_MAB={{W_MAB}} W_MCR={{W_MCR}} W_MSW={{W_MSW}} W_PASS={{W_PASS}} W_RFB={{W_RFB}} W_WLB={{W_WLB}} W_WLS={{W_WLS}}

opts options temp=60.0 tnom=27 reltol=0.0001 save=selected
save VB_ENABLE:p VB_VBIAS:p VB_VSS:p VIN:p XDUT.N2 XDUT.NCF XDUT.VFB XDUT.VG out vin vref

tr1 tran stop=0.00012000000000000002 maxstep=1e-08 errpreset=moderate
simulator lang=spice
.include 'measures.sp'
.end
