						<field Name="expression" Type="list">if((abs((average(clip(getData("OUT" ?result "tran") 0.000295 0.0003)) - average(clip(getData("OUT" ?result "tran") 0.00029 0.000295)))) &lt; 0.00020345) then ((100 * average(clip(((getData("OUT" ?result "tran") * getData("OUT" ?result "tran")) / 1000000.0) 0.000295 0.0003))) / average(clip((((- getData("VDD" ?result "tran")) * getData("VDD_SRC:p" ?result "tran")) - (getData("CLKA" ?result "tran") * getData("CLK_A:p" ?result "tran")) - (getData("CLKB" ?result "tran") * getData("CLK_B:p" ?result "tran"))) 0.000295 0.0003))) else nil)</field>
