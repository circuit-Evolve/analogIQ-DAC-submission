simulator lang=spectre
global 0
include "<PDK_ROOT>/sky130_cds/spectre/libs.tech/combined/sky130.lib.spice" section=ss
include "dut.scs"

parameters vsup=3.0 vneg=0.0
// Supplies (charged to the DUT power metrics).
VSUP (vdd 0) vsource dc=vsup
VNEG (vss 0) vsource dc=vneg

CLK_A (upin 0) vsource type=pulse val0=0 val1=vsup delay=1e-09 rise=1e-09 fall=1e-09 width=2.2e-08 period=5e-08
CLK_B (dnin 0) vsource type=pulse val0=0 val1=vsup delay=2.5999999999999998e-08 rise=1e-09 fall=1e-09 width=2.2e-08 period=5e-08
RLOAD (out 0) resistor r=1000000.0

