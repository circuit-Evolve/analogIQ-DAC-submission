simulator lang=spectre
global 0
include "<CADENCE_SHARED>/FOUNDRY/analog/180nm/models/spectre/gpdk.scs" section=FS
include "dut.scs"

parameters vin=1.9799985000000002 iload=0.0011 cout=0.0
// Supplies (charged to the DUT power metrics).
VIN (vin 0) vsource dc=vin
// External bias (topology external_bias; reported separately as bias power).
VB_VSS (b_VSS 0) vsource dc=0.0

VREFS (vref 0) vsource dc=1.2
// Load: ideal current sink out->ground and output capacitor (+ESR).
ILOAD (out 0) isource dc=iload
COUT (out 0) capacitor c=cout

XDUT (vin b_VSS vref out) ldo24c_conventional_dut C_FF=1e-12 I_BIAS=1e-05 L_BD=1e-06 L_CS=1e-06 L_FOL=1e-06 L_IN=1e-06 L_ML=1e-06 L_MS=1e-06 L_NM=1e-06 L_PASS=1e-06 L_TL=1e-06 M_BD=1.0 M_CS=1.0 M_FOL=1.0 M_IN=1.0 M_ML=1.0 M_MS=1.0 M_NM=1.0 M_PASS=1.0 M_TL=1.0 RESR_VALUE=0.3 RPAD=0.5 R_FB1=10000.0 R_FB2=10000.0 W_BD=1e-06 W_CS=1e-06 W_FOL=1e-06 W_IN=1e-06 W_ML=1e-06 W_MS=1e-06 W_NM=1e-06 W_PASS=1e-06 W_TL=1e-06
op_info info what=oppoint where=rawfile

opts options temp=100.0 tnom=27 reltol=0.0001 save=selected
save VB_VSS:p VIN:p XDUT.EAOUT XDUT.TAIL XDUT.VBUF XDUT.VFB out vin vref

regop1 dc
stb1 stb start=1.0 stop=100000000.0 dec=20 probe=XDUT.IPRB_LOOP
