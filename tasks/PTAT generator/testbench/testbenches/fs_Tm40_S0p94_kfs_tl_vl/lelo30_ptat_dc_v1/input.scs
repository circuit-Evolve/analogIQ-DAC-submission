// recipe lelo30_ptat_dc_v1 v1  condition fs_Tm40_S0p94_kfs_tl_vl (models fs, -40 C, supply 1.7 V)
// request ptat_lelo_task_001__plan  candidate 9fd967f9dc055ba4
// execution profile search_full
simulator lang=spectre
global 0
include "<PDK_ROOT>/sky130_cds/spectre/libs.tech/combined/sky130.lib.spice" section=fs
include "dut.scs"

parameters vsup=1.6999992 vneg=0.0
// Supplies (charged to the DUT power metrics).
VSUP (vdd 0) vsource dc=vsup
VNEG (vss 0) vsource dc=vneg

VPWR (pwr 0) vsource dc=vsup
VPWRN (pwrn 0) vsource dc=0
VIO0 (iout0 0) vsource dc=0.6
VLP (lpo lpi) vsource dc=0
nodeset XDUT.VR1=0.7 vd1=0.7 lpi=0.6 lpo=0.6

XDUT (vdd vss lpi lpo iout3 iout2 iout1 iout0 vd1 pwr pwrn) ptat_lelo_dut L_BS=1e-06 L_CAS=1e-06 L_CLPI=1e-06 L_CVCP=1e-06 L_LVT=1e-06 L_MIR=1e-06 L_NCR=1e-06 L_NLD=1e-06 L_PMIR=1e-06 L_RLAD=1e-06 L_RTAIL=1e-06 NF_BS=1.0 NF_CAS=1.0 NF_LVT=1.0 NF_MIR=1.0 NF_NCR=1.0 NF_NLD=1.0 NF_PMIR=1.0 W_BS=1e-06 W_CAS=1e-06 W_CLPI=1e-06 W_CVCP=1e-06 W_LVT=1e-06 W_MIR=1e-06 W_NCR=1e-06 W_NLD=1e-06 W_PMIR=1e-06 W_RLAD=1e-06 W_RTAIL=1e-06

opts options temp=-40.0 tnom=27 reltol=0.0001 save=selected
save VIO0:p VNEG:p VSUP:p XDUT.VD2 XDUT.VR1 iout0 iout1 iout2 iout3 lpi lpo pwr pwrn vd1 vdd vss

dct dc param=temp start=-45.0 stop=125.0 step=5.0
