// analogiq 0.1.0 testbench - generated, do not edit
// task ptat_lelo_task_001  topology ptat_lelo
// recipe lelo30_ptat_lstb_v1 v1  condition ss_hh_T125_S1p06_kss_th_vh (models ss_hh, 125 C, supply 1.9 V)
// request ptat_lelo_task_001__plan  candidate 9fd967f9dc055ba4
// execution profile search_full
simulator lang=spectre
global 0
include "<PDK_ROOT>/sky130_cds/spectre/libs.tech/combined/sky130.lib.spice" section=ss_hh
include "dut.scs"

parameters vsup=1.9000008 vneg=0.0
// Supplies (charged to the DUT power metrics).
VSUP (vdd 0) vsource dc=vsup
VNEG (vss 0) vsource dc=vneg

VPWR (pwr 0) vsource dc=vsup
VPWRN (pwrn 0) vsource dc=0
VIO0 (iout0 0) vsource dc=0.6
IPRB (lpi lpo) iprobe
nodeset XDUT.VR1=0.7 vd1=0.7 lpi=0.6 lpo=0.6

XDUT (vdd vss lpi lpo iout3 iout2 iout1 iout0 vd1 pwr pwrn) ptat_lelo_dut L_BS={{L_BS}} L_CAS={{L_CAS}} L_CLPI={{L_CLPI}} L_CVCP={{L_CVCP}} L_LVT={{L_LVT}} L_MIR={{L_MIR}} L_NCR={{L_NCR}} L_NLD={{L_NLD}} L_PMIR={{L_PMIR}} L_RLAD={{L_RLAD}} L_RTAIL={{L_RTAIL}} NF_BS={{NF_BS}} NF_CAS={{NF_CAS}} NF_LVT={{NF_LVT}} NF_MIR={{NF_MIR}} NF_NCR={{NF_NCR}} NF_NLD={{NF_NLD}} NF_PMIR={{NF_PMIR}} W_BS={{W_BS}} W_CAS={{W_CAS}} W_CLPI={{W_CLPI}} W_CVCP={{W_CVCP}} W_LVT={{W_LVT}} W_MIR={{W_MIR}} W_NCR={{W_NCR}} W_NLD={{W_NLD}} W_PMIR={{W_PMIR}} W_RLAD={{W_RLAD}} W_RTAIL={{W_RTAIL}}

opts options temp=125.0 tnom=27 reltol=0.0001 save=selected
save VIO0:p VNEG:p VSUP:p XDUT.VD2 XDUT.VR1 iout0 iout1 iout2 iout3 lpi lpo pwr pwrn vd1 vdd vss

dc1 dc
stb1 stb start=1.0 stop=1000000000.0 dec=30 probe=IPRB
