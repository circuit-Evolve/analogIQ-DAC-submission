// analogiq 0.1.0 testbench - generated, do not edit
// task temp_sensor_101126_task_001  topology ts1111_ptat_sensor
// recipe ts1111_tsweep_v1 v1  condition tt_binned_T27_S1p00 (models tt_binned, 27 C, supply 1.8 V)
// request temp_sensor_101126_task_001__plan  candidate b9e94b889d74eaf0
// execution profile search_full
simulator lang=spectre
global 0
include "<PDK_ROOT>/sky130_cds/spectre/libs.tech/spectre/sky130.lib.spice" section=tt
include "dut.scs"

parameters vsup=1.8 vneg=0.0
// Supplies (charged to the DUT power metrics).
VSUP (vdd 0) vsource dc=vsup
VNEG (vss 0) vsource dc=vneg

// no load and no stimulus: the output is read open (replay deck)

XDUT (vdd vss out) ts1111_sensor_dut L_BC={{L_BC}} L_BN={{L_BN}} L_BP={{L_BP}} L_I12={{L_I12}} L_I13={{L_I13}} L_LD={{L_LD}} L_N8={{L_N8}} L_N9={{L_N9}} L_P7={{L_P7}} L_TL={{L_TL}} M_BC={{M_BC}} M_BN={{M_BN}} M_BP={{M_BP}} M_I12={{M_I12}} M_I13={{M_I13}} M_LD={{M_LD}} M_N8={{M_N8}} M_N9={{M_N9}} M_P7={{M_P7}} M_TL={{M_TL}} W_BC={{W_BC}} W_BN={{W_BN}} W_BP={{W_BP}} W_I12={{W_I12}} W_I13={{W_I13}} W_LD={{W_LD}} W_N8={{W_N8}} W_N9={{W_N9}} W_P7={{W_P7}} W_TL={{W_TL}}
op_info info what=oppoint where=rawfile

opts options temp=27.0 tnom=27 reltol=0.0001 save=selected
save VNEG:p VSUP:p out vdd vss

tstol options vabstol=1e-09 iabstol=1e-14 soft_bin=allmodels
tsweep dc param=temp start=0.0 stop=100.0 step=1.0
